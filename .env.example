# Supabase — obtenha em https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Service Role — NUNCA exponha no frontend. Usada só pelo painel /admin
# Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Senha do painel administrativo (/admin)
ADMIN_SECRET=troque-esta-senha-admin

# URL pública do site (usada nos redirects do Magic Link)
# Produção: https://alexjdantas.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
